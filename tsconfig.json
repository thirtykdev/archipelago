{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@archipelago/core": [
        "packages/core/src/index.ts"
      ],
      "@archipelago/importer-station-file": [
        "importers/station-file/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "importers/*/src",
    "apps/*/src",
    "fixtures/synthetic/*.ts"
  ]
}