{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@archipelago/core": [
        "packages/core/src/index.ts"
      ],
      "@archipelago/importer-station-file": [
        "importers/station-file/src/index.ts"
      ],
      "@archipelago/importer-controller-file": [
        "importers/controller-file/src/index.ts"
      ],
      "@archipelago/connector-simulated": [
        "connectors/simulated/src/index.ts"
      ],
      "@archipelago/edge": [
        "apps/edge/src/index.ts"
      ],
      "@archipelago/connector-bacnet-ip": [
        "connectors/bacnet-ip/src/index.ts"
      ],
      "@archipelago/connector-bacnet-ip/testdevice": [
        "connectors/bacnet-ip/src/testdevice.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "importers/*/src",
    "connectors/*/src",
    "apps/*/src",
    "fixtures/synthetic/*.ts"
  ]
}